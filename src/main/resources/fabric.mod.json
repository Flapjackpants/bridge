{
	"schemaVersion": 1,
	"id": "discordbridge",
	"version": "${version}",
	"name": "Discord Bridge",
	"description": "Relays Minecraft chat and events to a Discord channel and Discord messages into Minecraft.",
	"authors": [
		"Flapjackpants"
	],
	"contact": {
		"homepage": "https://github.com/Flapjackpants/bridge",
		"sources": "https://github.com/Flapjackpants/bridge",
		"issues": "https://github.com/Flapjackpants/bridge/issues"
	},
	"license": "MIT",
	"icon": "assets/discordbridge/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.flapjackpants.discordbridge.DiscordBridgeMod"
		],
		"client": [
			"io.github.flapjackpants.discordbridge.client.DiscordBridgeClient"
		],
		"modmenu": [
			"io.github.flapjackpants.discordbridge.client.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "discordbridge.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
